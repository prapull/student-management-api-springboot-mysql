pipeline {
  agent any
  environment {
    IMAGE = "prapullkhar/student-api:v1"
    EC2_HOST = "your.ec2.ip.address"
    EC2_USER = "ubuntu"
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build JAR') {
      steps {
        // change into the sub-project that contains mvnw and pom.xml
        dir('Student-Management-System-main/SpringBootRestAPI') {
          sh './mvnw -DskipTests package'
        }
        // archive the produced jar from its location
        archiveArtifacts artifacts: 'Student-Management-System-main/SpringBootRestAPI/target/*.jar', fingerprint: true
      }
    }

    stage('Notify') {
      steps { echo "Built JAR. Ready to deploy: ${IMAGE}" }
    }

    stage('Deploy to EC2') {
      steps {
        sshagent (credentials: ['ec2-ssh-key']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} 'docker pull ${IMAGE} || true'
            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} '
              docker stop student-api-test 2>/dev/null || true
              docker rm student-api-test 2>/dev/null || true
              docker run -d --name student-api-test --restart unless-stopped -p 80:8080 ${IMAGE}
            '
          """
        }
      }
    }
  }

  post {
    success { echo 'Pipeline succeeded.' }
    failure { echo 'Pipeline failed — check logs.' }
  }
}
